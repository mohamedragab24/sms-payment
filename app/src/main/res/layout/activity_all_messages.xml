<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#F7FBFD">
<TextView android:id="@+id/tvCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="28sp" android:textStyle="bold" android:textColor="#FF6937"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="إجمالي الرسائل" android:layout_marginBottom="6dp"/>
<android.widget.SearchView android:id="@+id/etSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:queryHint="بحث في الرسائل / رقم الحساب / المرسل"/>
<Spinner android:id="@+id/spProvider" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/rvMessages" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
