<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_screen" android:layoutDirection="rtl">
<TextView android:id="@+id/tvHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" android:textColor="#19324A"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="الحسابات التي استقبلت مبالغ من هذا المزود" android:textSize="13sp" android:textColor="#718294" android:layout_marginTop="4dp" android:layout_marginBottom="10dp"/>
<android.widget.SearchView android:id="@+id/etSearch" android:layout_width="match_parent" android:layout_height="50dp" android:queryHint="ابحث برقم الحساب" android:background="@drawable/bg_search"/>
<TextView android:id="@+id/tvEmptyState" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="لا توجد حسابات مرتبطة بهذا المزود" android:gravity="center" android:padding="32dp" android:textColor="#718294" android:visibility="gone"/>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/rvMessages" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp"/>
</LinearLayout>
