<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fillViewport="true"
    android:layoutDirection="rtl">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="→ رجوع"
        android:textColor="@color/brand_text"
        android:background="@drawable/bg_secondary_button" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="start"
        android:text="🧪 صفحة اختبار الدفع"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="start"
        android:text="اكتب نفس الرقم الذي أدخلته في الطلب ونفس المبلغ المطلوب (أي رقم وأي مبلغ). إذا تطابقا مع الطلب يُؤكَّد تلقائيًا ويتفعّل الكورس، وإلا لا يُؤكَّد."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:text="طريقة الدفع"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spMethod"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <EditText android:textColor="@color/text_primary" android:textColorHint="@color/text_hint"
            android:id="@+id/etFrom"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_search"
            android:gravity="start|center_vertical"
            android:hint="الرقم الذي حوّل منه (نفس رقم الطلب)"
            android:inputType="phone"
            android:padding="12dp" />

        <EditText android:textColor="@color/text_primary" android:textColorHint="@color/text_hint"
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_search"
            android:gravity="start|center_vertical"
            android:hint="المبلغ (نفس مبلغ الطلب)"
            android:inputType="numberDecimal"
            android:padding="12dp" />

        <EditText android:textColor="@color/text_primary" android:textColorHint="@color/text_hint"
            android:id="@+id/etTxId"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_search"
            android:gravity="start|center_vertical"
            android:hint="رقم العملية (اختياري)"
            android:inputType="text"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="start"
            android:text="التاريخ والوقت يُكتبان تلقائيًا"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_primary_button"
            android:text="إرسال للموقع"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card"
        android:gravity="start"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
</ScrollView>
