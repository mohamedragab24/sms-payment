<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F7FBFD">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="16dp" android:background="#FFFFFF">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="أهلاً بك مجدداً في فهمت" android:textColor="#26A9DE" android:textSize="14sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="mohamed ragab" android:textColor="#25A8DE" android:textSize="27sp" android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="✓" android:textColor="#25A8DE" android:textSize="25sp" android:background="#EAF8FE"/>
    </LinearLayout>

    <com.example.smstotelegram.ui.PaymentOrbitView android:layout_width="match_parent" android:layout_height="350dp" android:layout_marginTop="10dp" android:background="#FFFFFF"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="لوحة التحكم" android:textSize="22sp" android:textStyle="bold" android:textColor="#294B63" android:layout_marginTop="16dp" android:layout_marginBottom="10dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <androidx.cardview.widget.CardView android:id="@+id/cardMessages" android:layout_width="0dp" android:layout_height="120dp" android:layout_weight="1" android:layout_marginEnd="7dp" app:cardCornerRadius="18dp" app:cardElevation="2dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="إجمالي عدد الرسائل" android:textColor="#526C7D"/>
                <TextView android:id="@+id/tvTotalMessages" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FF6937" android:textSize="30sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="بحث وفلترة ←" android:textSize="11sp" android:textColor="#25A8DE"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView android:id="@+id/cardAccounts" android:layout_width="0dp" android:layout_height="120dp" android:layout_weight="1" android:layout_marginStart="7dp" app:cardCornerRadius="18dp" app:cardElevation="2dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="عدد أرقام الحسابات المتاحة" android:textColor="#526C7D"/>
                <TextView android:id="@+id/tvTotalNumbers" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#25A8DE" android:textSize="30sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="اضغط لعرض تفاصيل كل حساب" android:textSize="11sp" android:textColor="#526C7D"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <androidx.cardview.widget.CardView android:id="@+id/cardProviders" android:layout_width="match_parent" android:layout_height="105dp" android:layout_marginTop="14dp" app:cardCornerRadius="18dp" app:cardElevation="2dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="18dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="عدد مزودي الخدمة المضافين\nاضغط لعرض جميع مزودي الخدمة" android:textColor="#526C7D"/>
            <TextView android:id="@+id/tvTotalProviders" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FF6937" android:textSize="30sp" android:textStyle="bold"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
</ScrollView>
