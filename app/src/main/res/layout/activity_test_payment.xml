<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F9FC"
    android:fillViewport="true"
    android:layoutDirection="rtl">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="→ رجوع"
        android:textColor="#2196D2"
        android:background="@drawable/bg_secondary_button" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="start"
        android:text="🧪 صفحة اختبار الدفع"
        android:textColor="#19324A"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="start"
        android:text="ترسل هذه الصفحة عملية دفع تجريبية مباشرة لموقع فهمني. إذا تطابق المبلغ والرقم مع طلب معلّق يُؤكَّد الطلب تلقائيًا ويتفعّل الكورس."
        android:textColor="#718294"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:text="طريقة الدفع"
            android:textColor="#19324A"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spMethod"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <EditText
            android:id="@+id/etFrom"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_search"
            android:gravity="start|center_vertical"
            android:hint="الرقم الذي حوّل منه"
            android:inputType="phone"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_search"
            android:gravity="start|center_vertical"
            android:hint="المبلغ"
            android:inputType="numberDecimal"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etTxId"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_search"
            android:gravity="start|center_vertical"
            android:hint="رقم العملية (اختياري)"
            android:inputType="text"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="start"
            android:text="التاريخ والوقت يُكتبان تلقائيًا (وقت الإرسال الآن)"
            android:textColor="#718294"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_primary_button"
            android:text="إرسال للموقع"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card"
        android:gravity="start"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
</ScrollView>
