<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_screen" android:layoutDirection="rtl">
<TextView android:id="@+id/tvAccount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="23sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
<TextView android:id="@+id/tvProvider" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/text_secondary" android:layout_marginTop="3dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="105dp" android:orientation="horizontal" android:layout_marginTop="14dp">
<androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="5dp" app:cardCornerRadius="18dp" app:cardElevation="0dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@color/app_surface"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="إجمالي المبلغ" android:textColor="@color/text_secondary"/><TextView android:id="@+id/tvAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="25sp" android:textStyle="bold" android:textColor="#FF7043" android:layout_marginTop="7dp"/></LinearLayout></androidx.cardview.widget.CardView>
<androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" app:cardCornerRadius="18dp" app:cardElevation="0dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@color/app_surface"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="عدد العمليات" android:textColor="@color/text_secondary"/><TextView android:id="@+id/tvTransactions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="25sp" android:textStyle="bold" android:textColor="@color/brand_text" android:layout_marginTop="7dp"/></LinearLayout></androidx.cardview.widget.CardView>
</LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="رسائل هذا الحساب" android:textStyle="bold" android:textSize="18sp" android:textColor="@color/text_primary" android:layout_marginTop="16dp" android:layout_marginBottom="7dp"/>
<android.widget.SearchView android:id="@+id/etSearch" android:layout_width="match_parent" android:layout_height="50dp" android:queryHint="ابحث داخل رسائل الحساب" android:background="@drawable/bg_search"/>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/rvMessages" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp"/>
</LinearLayout>
