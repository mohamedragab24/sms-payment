<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_screen" android:layoutDirection="rtl">
<TextView android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="أرقام الحسابات المتاحة" android:textSize="23sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="اضغط على أي حساب لعرض الإحصائيات والرسائل الخاصة به" android:textSize="13sp" android:textColor="@color/text_secondary" android:layout_marginTop="4dp" android:layout_marginBottom="12dp"/>
<android.widget.SearchView android:id="@+id/etSearch" android:layout_width="match_parent" android:layout_height="50dp" android:queryHint="ابحث برقم الحساب أو مزود الخدمة" android:background="@drawable/bg_search"/>
<TextView android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="لا توجد حسابات مستلمة حتى الآن" android:gravity="center" android:padding="32dp" android:textColor="@color/text_secondary" android:visibility="gone"/>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/rvAccounts" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp"/>
</LinearLayout>
