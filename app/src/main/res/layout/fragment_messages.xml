<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_screen" android:layoutDirection="rtl">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="مزودو الخدمة" android:textSize="23sp" android:textStyle="bold" android:textColor="#19324A"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="اضغط على أي مزود لعرض الحسابات والأرقام المرتبطة به" android:textSize="13sp" android:textColor="#718294" android:layout_marginTop="4dp" android:layout_marginBottom="10dp"/>
<android.widget.SearchView android:id="@+id/etSearch" android:layout_width="match_parent" android:layout_height="50dp" android:queryHint="ابحث باسم المزود أو رقم الحساب" android:background="@drawable/bg_search"/>
<TextView android:id="@+id/tvEmptyState" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="لا يوجد مزودو خدمة مضافون بعد" android:gravity="center" android:padding="32dp" android:textColor="#718294" android:visibility="gone"/>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/rvProviders" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp"/>
<com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fabAddProvider" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:contentDescription="إضافة مزود خدمة" android:src="@android:drawable/ic_input_add" app:backgroundTint="#FF7043" app:tint="#FFFFFF"/>
</LinearLayout>
