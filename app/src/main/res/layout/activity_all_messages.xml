<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_screen" android:layoutDirection="rtl">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="إجمالي الرسائل" android:textSize="13sp" android:textColor="#718294"/>
<TextView android:id="@+id/tvCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="30sp" android:textStyle="bold" android:textColor="#FF7043"/>
</LinearLayout>
<TextView android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="✉" android:textSize="22sp" android:textColor="#FF7043" android:background="@drawable/bg_icon_orange"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ابحث أو اختر مزود الخدمة لتصفية النتائج" android:textColor="#718294" android:textSize="13sp" android:layout_marginTop="2dp" android:layout_marginBottom="10dp"/>
<android.widget.SearchView android:id="@+id/etSearch" android:layout_width="match_parent" android:layout_height="50dp" android:queryHint="بحث في الرسائل / رقم الحساب / المرسل" android:background="@drawable/bg_search"/>
<Spinner android:id="@+id/spProvider" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:background="@drawable/bg_search"/>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/rvMessages" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp"/>
</LinearLayout>
